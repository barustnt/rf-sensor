RF_ENV=development
RF_TIMEZONE=Asia/Dubai

# Laptop-local services and the local B210 sensor use loopback.
RF_PLATFORM_URL=http://127.0.0.1:8000
RF_API_HOST=0.0.0.0
RF_API_PORT=8000
RF_DASHBOARD_HOST=0.0.0.0
RF_DASHBOARD_PORT=7860
RF_ASK_RF_HOST=0.0.0.0
RF_ASK_RF_PORT=7861
RF_DISPLAY_TIMEZONE=Asia/Dubai
RF_API_TIMEOUT_SECONDS=5
RF_GRADIO_SHARE=false

RF_DATABASE_URL=postgresql+asyncpg://rf_platform:change-me@127.0.0.1:5432/rf_platform
RF_NATS_URL=nats://127.0.0.1:4222
RF_ARTIFACT_BACKEND=filesystem
RF_ARTIFACT_ROOT=.data/artifacts
RF_CORS_ORIGINS=http://127.0.0.1:7860,http://localhost:7860,http://127.0.0.1:7861,http://localhost:7861
RF_MAX_UPLOAD_BYTES=10485760

RF_SENSOR_ID=laptop-b210-001
RF_SENSOR_TOKEN=change-me
RF_SENSOR_DISPLAY_NAME=Laptop B210 Sensor
RF_SENSOR_LOCATION=lab
RF_SENSOR_ADAPTER=simulated
RF_SENSOR_PROFILE=campus_general
RF_HEARTBEAT_INTERVAL_SECONDS=10
RF_OFFLINE_AFTER_SECONDS=30
RF_SPOOL_ROOT=.data/spool
RF_SPOOL_MAX_BYTES=10737418240
RF_CAPTURE_INTERVAL_SECONDS=0
RF_SENSOR_RETRY_INITIAL_SECONDS=1
RF_SENSOR_RETRY_MAX_SECONDS=30

# Milestone 4 receive-only USRP B210 mode (copy to untracked .env.b210.local):
# RF_SENSOR_ADAPTER=b210
# RF_SENSOR_ID=laptop-b210-001
# RF_SENSOR_PROFILE=b210_2g4_demo
# RF_B210_DEVICE_ARGS=serial=321D88A
# RF_B210_SERIAL=321D88A
# RF_B210_RX_CHANNEL=0
# RF_B210_ANTENNA=RX2
# RF_B210_CENTER_FREQUENCY_HZ=2440000000
# RF_B210_SAMPLE_RATE_SPS=20000000
# RF_B210_BANDWIDTH_HZ=20000000
# RF_B210_GAIN_DB=30
# RF_B210_SAMPLE_COUNT=1048576
# RF_B210_RECEIVE_TIMEOUT_SECONDS=5
# RF_B210_SETTLING_SECONDS=0.1
# RF_B210_CPU_FORMAT=fc32
# RF_B210_WIRE_FORMAT=sc16
# RF_B210_PERSIST_RAW_IQ=false

RF_RFGPT_ADAPTER=mock
RF_RFGPT_MODEL_NAME=rfgpt
RF_RFGPT_MODEL_VERSION=mock-v1
RF_RFGPT_ENDPOINT=http://127.0.0.1:8090
RF_RFGPT_CONDA_ENV=
RF_RFGPT_REQUEST_TIMEOUT_SECONDS=120
RF_RFGPT_HEALTH_TIMEOUT_SECONDS=2
RF_RFGPT_TEMPERATURE=0
RF_RFGPT_TOP_P=1
RF_RFGPT_REPETITION_PENALTY=1.05
RF_RFGPT_MAX_OUTPUT_TOKENS=224
RF_WORKER_MAX_ATTEMPTS=5
RF_WORKER_CONCURRENCY=1

# Milestone 3 local vLLM mode (copy to untracked .env or .env.local and edit locally):
# RF_RFGPT_ADAPTER=vllm
# RF_RFGPT_ENDPOINT=http://127.0.0.1:8090/v1
# RF_RFGPT_MODEL_NAME=rfgpt
# RF_RFGPT_MODEL_VERSION=Qwen2.5-VL-7B-rfa-wtr-v2-joint
# RF_RFGPT_REQUEST_TIMEOUT_SECONDS=300
# RF_RFGPT_REPETITION_PENALTY=1.05
# RF_RFGPT_MAX_OUTPUT_TOKENS=224
# RF_WORKER_CONCURRENCY=1
# RF_RFGPT_MODEL_PATH=/local/untracked/model/path

# Milestone 2 retention remains report-only; no automated deletion.
RF_RETENTION_REPORT_ONLY=true
RF_RETENTION_HEARTBEAT_DAYS=30
RF_RETENTION_CAPTURE_DAYS=180
RF_RETENTION_ARTIFACT_DAYS=30
RF_RETENTION_LOG_DAYS=14
RF_STORAGE_WARNING_USED_PERCENT=85
RF_STORAGE_CRITICAL_USED_PERCENT=95
